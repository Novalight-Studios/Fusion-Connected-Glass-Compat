{
    "multipart": [
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_post"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_side_north"
            },
            "when": {
                "north": "true"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_side_east",
                "y": 90
            },
            "when": {
                "east": "true"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_side_south"
            },
            "when": {
                "south": "true"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_side_west",
                "y": 90
            },
            "when": {
                "west": "true"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_noside"
            },
            "when": {
                "north": "false"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_noside_alt"
            },
            "when": {
                "east": "false"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_noside_alt",
                "y": 90
            },
            "when": {
                "south": "false"
            }
        },
        {
            "apply": {
                "model": "undergarden:block/panes/sediment_glass_pane_noside",
                "y": 270
            },
            "when": {
                "west": "false"
            }
        }
    ]
}
